{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@p-otero/oxlint-rules/presets/react.json",
    "./node_modules/@p-otero/oxlint-rules/presets/ui-tailwind.json"
  ],
  "plugins": ["react", "jsx-a11y"],
  "jsPlugins": ["./node_modules/@p-otero/oxlint-rules/dist/plugin.js", "@shadcn/lint", "./eskais-oxlint-plugin.js"],
  "rules": {
    "p-otero/one-public-component": "off",
    "p-otero/component-name-matches-file": "off",
    "p-otero/max-component-lines": "off",
    "p-otero/no-large-private-component": "off",
    "p-otero/spacing-tokens": [
      "warn",
      {
        "roles": [
          "gap-inline",
          "gap-items",
          "gap-group",
          "gap-section",
          "px-inset-chip",
          "py-inset-chip",
          "px-inset-item",
          "py-inset-item",
          "px-control-x",
          "p-inset-surface",
          "p-control-inset"
        ]
      }
    ],
    "shadcn/no-raw-colors": ["error", { "mergeFunctions": ["cnState"] }],
    "shadcn/no-arbitrary-values": [
      "warn",
      { "allow": ["max-h-[calc(100%-2rem)]", "w-[calc(100%-2rem)]"], "mergeFunctions": ["cnState"] }
    ],
    "shadcn/require-static-classes": ["error", { "mergeFunctions": ["cnState"] }],
    "shadcn/no-restyle": ["error", { "allow": ["layout"], "mergeFunctions": ["cnState"] }],
    "eskais/icon-button-needs-label": "error",
    "eskais/scroll-area": "warn",
    "eskais/no-inline-icons": "warn",
    "p-otero/no-callback-prop-in-effect-deps": "warn",
    "p-otero/no-latest-ref-effect": "warn",
    "p-otero/prefer-sync-external-store": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@ui-sdk/*/internal/*", "@ui-sdk/core/internal"],
            "message": "Import UI SDK from its public entries."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["components/ui/**", "src/components/ui/**"],
      "rules": { "shadcn/no-restyle": "off" }
    },
    {
      "files": ["**/lib/diff-async.ts", "**/lib/diff-lines.ts", "**/lib/diff-sequence.ts", "**/lib/sky-photo.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "warn",
        "unicorn/require-post-message-target-origin": "warn",
        "no-await-in-loop": "warn"
      }
    }
  ]
}
