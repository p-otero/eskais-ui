{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@p-otero/oxlint-rules/presets/react.json",
    "./node_modules/@p-otero/oxlint-rules/presets/ui-tailwind.json"
  ],
  "plugins": ["react", "jsx-a11y"],
  "jsPlugins": ["./node_modules/@p-otero/oxlint-rules/dist/plugin.js", "@shadcn/lint", "./eskais-oxlint-plugin.js"],
  "rules": {
    "p-otero/one-public-component": "off",
    "p-otero/component-name-matches-file": "off",
    "p-otero/max-component-lines": "off",
    "p-otero/no-large-private-component": "off",
    "p-otero/spacing-tokens": [
      "warn",
      {
        "roles": [
          "gap-inline",
          "gap-items",
          "gap-group",
          "gap-section",
          "px-inset-chip",
          "py-inset-chip",
          "px-inset-item",
          "py-inset-item",
          "px-control-x",
          "p-inset-surface",
          "p-control-inset"
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "warn",
    "shadcn/require-static-classes": "error",
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "eskais/icon-button-needs-label": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@ui-sdk/*/internal/*", "@ui-sdk/core/internal"],
            "message": "Import UI SDK from its public entries."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["components/ui/**", "src/components/ui/**"],
      "rules": { "shadcn/no-restyle": "off" }
    }
  ]
}
