    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "cn() and cnState(), which merges classes into a UI SDK className that may be a function of state.",
      "dependencies": [
        "clsx@2.1.1",
        "tailwind-merge@3.7.0"
      ],
      "files": [
        {
          "path": "registry/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Theme",
      "description": "Semantic color tokens plus shape, density and surface tokens. The default look: rounded, roomy, soft shadows.",
      "docs": "Add `@layer ui-sdk;` as the first line of your global stylesheet, above `@import \"tailwindcss\"`, so your styles win over UI SDK's behavior CSS.",
      "css": {
        ":where(:root)": {
          "--control-radius": "2rem",
          "--control-height": "2.25rem",
          "--control-height-sm": "2rem",
          "--control-height-lg": "2.5rem",
          "--control-padding": "0.875rem",
          "--choice-radius": "0.5rem",
          "--surface-radius": "2rem",
          "--surface-padding": "1.5rem",
          "--surface-shadow": "0 4px 12px -2px oklch(0 0 0 / 0.08), 0 2px 4px -2px oklch(0 0 0 / 0.04)",
          "--surface-backdrop": "none",
          "--glass-opacity": "100%",
          "--glass-blur": "0px",
          "--glass-saturation": "1",
          "--board-column-min-width": "16rem",
          "--board-column-max-width": "22rem",
          "--board-column-max-height": "40rem"
        },
        "@utility backdrop-surface": {
          "-webkit-backdrop-filter": "var(--surface-backdrop)",
          "backdrop-filter": "var(--surface-backdrop)"
        },
        "@utility content-auto": {
          "content-visibility": "auto",
          "contain-intrinsic-height": "auto var(--intrinsic-height, 24rem)"
        },
        "@utility text-vertical": {
          "writing-mode": "vertical-rl"
        },
        "@layer base": {
          "[data-slot=\"button\"]:not([data-pending]) [data-show=\"pending\"], [data-slot=\"button\"][data-pending] [data-show=\"idle\"], [data-slot=\"alert-dialog-close\"]:not([data-pending]) [data-show=\"pending\"], [data-slot=\"alert-dialog-close\"][data-pending] [data-show=\"idle\"]": {
            "display": "none"
          }
        }
      },
      "cssVars": {
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
          "color-card-foreground": "var(--card-foreground)",
          "color-popover": "var(--popover)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-secondary": "var(--secondary)",
          "color-secondary-foreground": "var(--secondary-foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-accent": "var(--accent)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-destructive": "var(--destructive)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-info": "var(--info)",
          "color-info-foreground": "var(--info-foreground)",
          "color-border": "var(--border)",
          "color-input": "var(--input)",
          "color-ring": "var(--ring)",
          "color-overlay": "var(--overlay)",
          "radius-sm": "calc(var(--radius) - 4px)",
          "radius-md": "calc(var(--radius) - 2px)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) + 4px)",
          "radius-control": "var(--control-radius)",
          "radius-choice": "min(var(--choice-radius), 30%)",
          "radius-surface": "var(--surface-radius)",
          "spacing-control": "var(--control-height)",
          "spacing-control-sm": "var(--control-height-sm)",
          "spacing-control-lg": "var(--control-height-lg)",
          "spacing-control-x": "var(--control-padding)",
          "spacing-surface": "var(--surface-padding)",
          "shadow-surface": "var(--surface-shadow)"
        },
        "light": {
          "radius": "1rem",
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.205 0 0)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.97 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.97 0 0)",
          "muted-foreground": "oklch(0.43 0 0)",
          "accent": "oklch(0.97 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.505 0.213 27.518)",
          "destructive-foreground": "oklch(0.985 0 0)",
          "success": "oklch(0.448 0.119 151.328)",
          "success-foreground": "oklch(0.985 0 0)",
          "warning": "oklch(0.473 0.137 46.201)",
          "warning-foreground": "oklch(0.985 0 0)",
          "info": "oklch(0.488 0.243 264.376)",
          "info-foreground": "oklch(0.985 0 0)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.6 0 0)",
          "ring": "oklch(0.556 0 0)",
          "overlay": "oklch(0 0 0 / 0.5)"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.922 0 0)",
          "primary-foreground": "oklch(0.205 0 0)",
          "secondary": "oklch(0.269 0 0)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.76 0 0)",
          "accent": "oklch(0.269 0 0)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "destructive-foreground": "oklch(0.145 0 0)",
          "success": "oklch(0.696 0.17 162.48)",
          "success-foreground": "oklch(0.145 0 0)",
          "warning": "oklch(0.828 0.189 84.429)",
          "warning-foreground": "oklch(0.145 0 0)",
          "info": "oklch(0.707 0.165 254.624)",
          "info-foreground": "oklch(0.145 0 0)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(0.55 0 0)",
          "ring": "oklch(0.708 0 0)",
          "overlay": "oklch(0 0 0 / 0.7)"
        }
      }
