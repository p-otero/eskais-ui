    {
      "name": "theme-compact",
      "type": "registry:theme",
      "title": "Compact theme",
      "description": "Denser controls, tighter radii and padding. Applies inside any element with data-theme=\"compact\".",
      "registryDependencies": [
        "@eskais/theme"
      ],
      "css": {
        "[data-theme=\"compact\"]": {
          "--radius": "0.5rem",
          "--control-radius": "0.5rem",
          "--control-height": "2rem",
          "--control-height-sm": "1.75rem",
          "--control-height-lg": "2.25rem",
          "--control-padding": "0.625rem",
          "--choice-radius": "0.25rem",
          "--surface-radius": "0.75rem",
          "--surface-padding": "1rem",
          "--surface-shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
          "--board-column-min-width": "14rem",
          "--board-column-max-width": "18rem"
        }
      }
    },
    {
      "name": "theme-glass",
      "type": "registry:theme",
      "title": "Glass theme",
      "description": "Translucent, blurred surfaces. Applies inside any element with data-theme=\"glass\"; tune it with --glass-opacity and --glass-blur.",
      "registryDependencies": [
        "@eskais/theme"
      ],
      "css": {
        "[data-theme=\"glass\"]": {
          "--glass-opacity": "60%",
          "--glass-blur": "20px",
          "--glass-saturation": "1.6",
          "--surface-backdrop": "blur(var(--glass-blur)) saturate(var(--glass-saturation))",
          "--surface-shadow": "inset 0 1px 0 oklch(1 0 0 / 0.25), 0 12px 40px -12px oklch(0 0 0 / 0.3)"
        },
        "@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))": {
          "[data-theme=\"glass\"]": {
            "--glass-opacity": "100% !important"
          }
        },
        "@media (prefers-reduced-transparency: reduce)": {
          "[data-theme=\"glass\"]": {
            "--glass-opacity": "100% !important",
            "--surface-backdrop": "none !important"
          }
        }
      }
    },
