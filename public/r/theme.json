{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Theme",
  "description": "Semantic color tokens plus shape, density and surface tokens. The default look: rounded, roomy, soft shadows.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Geist Variable\", ui-sans-serif, system-ui, sans-serif",
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-destructive": "var(--destructive)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-success": "var(--success)",
      "color-success-foreground": "var(--success-foreground)",
      "color-warning": "var(--warning)",
      "color-warning-foreground": "var(--warning-foreground)",
      "color-info": "var(--info)",
      "color-info-foreground": "var(--info-foreground)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "color-overlay": "var(--overlay)",
      "color-chart-1": "var(--chart-1)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-5": "var(--chart-5)",
      "radius-sm": "calc(var(--radius) - 4px)",
      "radius-md": "calc(var(--radius) - 2px)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) + 4px)",
      "radius-control": "var(--control-radius)",
      "radius-choice": "min(var(--choice-radius), 30%)",
      "radius-surface": "var(--surface-radius)",
      "spacing-control": "var(--control-height)",
      "spacing-control-sm": "var(--control-height-sm)",
      "spacing-control-lg": "var(--control-height-lg)",
      "spacing-control-x": "var(--control-padding)",
      "spacing-inline": "var(--gap-inline)",
      "spacing-items": "var(--gap-items)",
      "spacing-group": "var(--gap-group)",
      "spacing-section": "var(--gap-section)",
      "spacing-inset-surface": "var(--surface-padding)",
      "spacing-surface": "var(--surface-padding)",
      "spacing-control-inset": "calc((var(--control-height) - var(--control-height-sm)) / 2)",
      "shadow-surface": "var(--surface-shadow)"
    },
    "light": {
      "radius": "1rem",
      "brand": "oklch(0.205 0 0)",
      "neutral-hue": "0",
      "neutral-chroma": "0",
      "destructive": "oklch(0.505 0.213 27.518)",
      "destructive-foreground": "oklch(0.985 0 0)",
      "success": "oklch(0.448 0.119 151.328)",
      "success-foreground": "oklch(0.985 0 0)",
      "warning": "oklch(0.473 0.137 46.201)",
      "warning-foreground": "oklch(0.985 0 0)",
      "info": "oklch(0.488 0.243 264.376)",
      "info-foreground": "oklch(0.985 0 0)",
      "overlay": "oklch(0 0 0 / 0.5)",
      "chart-1": "#2a78d6",
      "chart-2": "#eb6834",
      "chart-3": "#0ba975",
      "chart-4": "oklch(0.44 0.16 305)",
      "chart-5": "oklch(0.48 0.09 75)",
      "background": "oklch(1 var(--neutral-chroma) var(--neutral-hue))",
      "foreground": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "card": "oklch(1 var(--neutral-chroma) var(--neutral-hue))",
      "card-foreground": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "popover": "oklch(1 var(--neutral-chroma) var(--neutral-hue))",
      "popover-foreground": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "primary": "var(--brand)",
      "primary-foreground": "color(\n    from var(--primary) xyz-d65\n      calc(\n        0.95047 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n      clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      calc(\n        1.08883 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n  )",
      "secondary": "oklch(0.97 var(--neutral-chroma) var(--neutral-hue))",
      "secondary-foreground": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "muted": "oklch(0.97 var(--neutral-chroma) var(--neutral-hue))",
      "muted-foreground": "oklch(0.43 var(--neutral-chroma) var(--neutral-hue))",
      "accent": "oklch(from var(--brand) 0.97 min(c, 0.03) h)",
      "accent-foreground": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "border": "oklch(0.922 var(--neutral-chroma) var(--neutral-hue))",
      "input": "oklch(0.6 var(--neutral-chroma) var(--neutral-hue))",
      "ring": "oklch(from var(--brand) max(l, 0.556) c h)"
    },
    "dark": {
      "destructive": "oklch(0.704 0.191 22.216)",
      "destructive-foreground": "oklch(0.145 0 0)",
      "success": "oklch(0.696 0.17 162.48)",
      "success-foreground": "oklch(0.145 0 0)",
      "warning": "oklch(0.828 0.189 84.429)",
      "warning-foreground": "oklch(0.145 0 0)",
      "info": "oklch(0.707 0.165 254.624)",
      "info-foreground": "oklch(0.145 0 0)",
      "overlay": "oklch(0 0 0 / 0.7)",
      "chart-1": "#3987e5",
      "chart-2": "#d95926",
      "chart-3": "#199e70",
      "chart-4": "oklch(0.8 0.11 305)",
      "chart-5": "oklch(0.86 0.14 90)",
      "background": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "card": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "card-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "popover": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "popover-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "primary": "oklch(from var(--brand) max(l, 1.127 - l, 0.72) c h)",
      "primary-foreground": "color(\n    from var(--primary) xyz-d65\n      calc(\n        0.95047 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n      clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      calc(\n        1.08883 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n  )",
      "secondary": "oklch(0.269 var(--neutral-chroma) var(--neutral-hue))",
      "secondary-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "muted": "oklch(0.269 var(--neutral-chroma) var(--neutral-hue))",
      "muted-foreground": "oklch(0.76 var(--neutral-chroma) var(--neutral-hue))",
      "accent": "oklch(from var(--brand) 0.269 min(c, 0.04) h)",
      "accent-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "border": "oklch(1 var(--neutral-chroma) var(--neutral-hue) / 10%)",
      "input": "oklch(0.55 var(--neutral-chroma) var(--neutral-hue))",
      "ring": "oklch(from var(--primary) min(l, 0.708) c h)"
    }
  },
  "css": {
    ":where(:root)": {
      "--control-radius": "calc(var(--radius) * 2)",
      "--control-height": "2.25rem",
      "--control-height-sm": "2rem",
      "--control-height-lg": "2.5rem",
      "--control-padding": "0.875rem",
      "--choice-radius": "calc(var(--radius) / 2)",
      "--surface-radius": "calc(var(--radius) * 2)",
      "--surface-padding": "1.5rem",
      "--gap-inline": "0.375rem",
      "--gap-items": "0.5rem",
      "--gap-group": "1rem",
      "--gap-section": "1.5rem",
      "--chip-padding-x": "0.5rem",
      "--chip-padding-y": "0.125rem",
      "--item-padding-x": "0.625rem",
      "--item-padding-y": "0.5rem",
      "--surface-shadow": "0 4px 12px -2px oklch(0 0 0 / 0.08), 0 2px 4px -2px oklch(0 0 0 / 0.04)",
      "--surface-backdrop": "none",
      "--glass-opacity": "100%",
      "--glass-blur": "0px",
      "--glass-saturation": "1",
      "--board-column-min-width": "16rem",
      "--board-column-max-width": "22rem",
      "--board-column-max-height": "40rem",
      "--task-panel-width": "26rem",
      "--task-panel-max-height": "32rem",
      "--sidebar-width": "16rem",
      "--sidebar-rail-width": "calc(var(--control-height) + 1rem)"
    },
    "[data-palette]": {
      "--background": "oklch(1 var(--neutral-chroma) var(--neutral-hue))",
      "--foreground": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "--card": "oklch(1 var(--neutral-chroma) var(--neutral-hue))",
      "--card-foreground": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "--popover": "oklch(1 var(--neutral-chroma) var(--neutral-hue))",
      "--popover-foreground": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "--primary": "var(--brand)",
      "--primary-foreground": "color(\n    from var(--primary) xyz-d65\n      calc(\n        0.95047 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n      clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      calc(\n        1.08883 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n  )",
      "--secondary": "oklch(0.97 var(--neutral-chroma) var(--neutral-hue))",
      "--secondary-foreground": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "--muted": "oklch(0.97 var(--neutral-chroma) var(--neutral-hue))",
      "--muted-foreground": "oklch(0.43 var(--neutral-chroma) var(--neutral-hue))",
      "--accent": "oklch(from var(--brand) 0.97 min(c, 0.03) h)",
      "--accent-foreground": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "--border": "oklch(0.922 var(--neutral-chroma) var(--neutral-hue))",
      "--input": "oklch(0.6 var(--neutral-chroma) var(--neutral-hue))",
      "--ring": "oklch(from var(--brand) max(l, 0.556) c h)"
    },
    ".dark [data-palette], [data-palette].dark": {
      "--background": "oklch(0.145 var(--neutral-chroma) var(--neutral-hue))",
      "--foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "--card": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "--card-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "--popover": "oklch(0.205 var(--neutral-chroma) var(--neutral-hue))",
      "--popover-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "--primary": "oklch(from var(--brand) max(l, 1.127 - l, 0.72) c h)",
      "--primary-foreground": "color(\n    from var(--primary) xyz-d65\n      calc(\n        0.95047 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n      clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      calc(\n        1.08883 *\n          clamp(min(0.008615, max(0, (y - 0.179) * 0.2)), (0.179 - y) * 1e6, max(0.955672, 1 - (0.179 - y) * 4.5))\n      )\n  )",
      "--secondary": "oklch(0.269 var(--neutral-chroma) var(--neutral-hue))",
      "--secondary-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "--muted": "oklch(0.269 var(--neutral-chroma) var(--neutral-hue))",
      "--muted-foreground": "oklch(0.76 var(--neutral-chroma) var(--neutral-hue))",
      "--accent": "oklch(from var(--brand) 0.269 min(c, 0.04) h)",
      "--accent-foreground": "oklch(0.985 var(--neutral-chroma) var(--neutral-hue))",
      "--border": "oklch(1 var(--neutral-chroma) var(--neutral-hue) / 10%)",
      "--input": "oklch(0.55 var(--neutral-chroma) var(--neutral-hue))",
      "--ring": "oklch(from var(--primary) min(l, 0.708) c h)"
    },
    "@supports not (color: oklch(from red l c h))": {
      ":root, [data-palette]": {
        "--primary-foreground": "oklch(0.985 0 0)",
        "--accent": "oklch(0.97 0 0)",
        "--ring": "oklch(0.556 0 0)"
      },
      ".dark, .dark [data-palette], [data-palette].dark": {
        "--primary": "oklch(0.922 0 0)",
        "--primary-foreground": "oklch(0.205 0 0)",
        "--accent": "oklch(0.269 0 0)",
        "--ring": "oklch(0.708 0 0)"
      }
    },
    "@utility backdrop-surface": {
      "-webkit-backdrop-filter": "var(--surface-backdrop)",
      "backdrop-filter": "var(--surface-backdrop)"
    },
    "@utility content-auto": {
      "content-visibility": "auto",
      "contain-intrinsic-height": "auto var(--intrinsic-height, 24rem)"
    },
    "@utility px-inset-chip": {
      "padding-inline": "var(--chip-padding-x)"
    },
    "@utility py-inset-chip": {
      "padding-block": "var(--chip-padding-y)"
    },
    "@utility px-inset-item": {
      "padding-inline": "var(--item-padding-x)"
    },
    "@utility py-inset-item": {
      "padding-block": "var(--item-padding-y)"
    },
    "@utility text-vertical": {
      "writing-mode": "vertical-rl"
    },
    "@layer base": {
      "[data-slot=\"button\"]:not([data-pending]) [data-show=\"pending\"], [data-slot=\"button\"][data-pending] [data-show=\"idle\"], [data-slot=\"alert-dialog-close\"]:not([data-pending]) [data-show=\"pending\"], [data-slot=\"alert-dialog-close\"][data-pending] [data-show=\"idle\"]": {
        "display": "none"
      }
    }
  },
  "docs": "Add `@layer ui-sdk;` as the first line of your global stylesheet, above `@import \"tailwindcss\"`, so your styles win over UI SDK's behavior CSS. The theme asks for Geist Variable and falls back to the system font: `npx shadcn add @eskais/font-geist` installs it (or add `@fontsource-variable/geist` and `@import \"@fontsource-variable/geist\";` yourself).",
  "type": "registry:theme"
}