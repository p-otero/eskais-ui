{
  "name": "eskais-ui",
  "version": "0.0.0",
  "private": true,
  "description": "UI SDK-first, agent-native React components distributed as a shadcn-style registry.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter showcase dev",
    "build:showcase": "bun run --filter showcase build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "bun tooling/sync-theme.ts && shadcn build",
    "registry:validate": "shadcn registry validate",
    "test:browser": "bun run build:showcase && node tooling/contrast-check.mjs && node tooling/contrast-check.mjs default --palettes=blue,violet,green,orange",
    "test:browser:glass": "bun run build:showcase && node tooling/contrast-check.mjs glass",
    "screenshots": "bun run build:showcase && node tooling/screenshots.mjs screenshots",
    "verify": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run registry:build"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@shadcn/lint": "0.2.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
