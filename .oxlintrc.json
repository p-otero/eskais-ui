{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@p-otero/oxlint-rules/presets/base.json",
    "./node_modules/@p-otero/oxlint-rules/presets/react.json",
    "./node_modules/@p-otero/oxlint-rules/presets/react-agents.json",
    "./node_modules/@p-otero/oxlint-rules/presets/ui-tailwind.json"
  ],
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn", "oxc", "vitest"],
  "jsPlugins": [
    "./node_modules/@p-otero/oxlint-rules/dist/plugin.js",
    "@shadcn/lint",
    "./tooling/oxlint-plugin-eskais/index.js"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "settings": {
    "shadcn": {
      "ui": "@/components/ui",
      "mergeFunctions": ["cnState"],
      "note": "Use the semantic tokens in registry/styles/theme.css; see AGENTS.md."
    }
  },
  "ignorePatterns": ["public/r/**", "node_modules/**", "dist/**", ".agents/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "react/globals": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/no-array-index-key": "error",
    "react/no-unstable-nested-components": "error",
    "react/react-in-jsx-scope": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@ui-sdk/*/internal/*", "@ui-sdk/core/internal"],
            "message": "Import UI SDK from its public entries."
          },
          {
            "regex": "^@ui-sdk/react$",
            "message": "Import UI SDK React from a subpath, like @ui-sdk/react/dialog."
          }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["max-h-[calc(100%-2rem)]", "w-[calc(100%-2rem)]"]
      }
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "oxc/no-map-spread": "off",
    "unicorn/prefer-set-has": "off",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/require-mock-type-parameters": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "checkServer", "checkPattern", "checkDirection"]
      }
    ],
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__UI_SDK_STRICT__"]
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "p-otero/one-public-component": "off",
    "p-otero/component-name-matches-file": "off",
    "p-otero/max-component-lines": "off",
    "p-otero/no-large-private-component": "off",
    "p-otero/spacing-tokens": "off",
    "p-otero/no-effect-outside-hooks": [
      "error",
      {
        "allow": ["**/hooks/**", "**/use-*.ts"]
      }
    ],
    "eskais/icon-button-needs-label": "error"
  },
  "overrides": [
    {
      "files": ["registry/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@ui-sdk/*/internal/*", "@ui-sdk/core/internal"],
                "message": "Import UI SDK from its public entries."
              },
              {
                "regex": "^@ui-sdk/react$",
                "message": "Import UI SDK React from a subpath, like @ui-sdk/react/dialog."
              },
              {
                "regex": "^(bun|bun:.*|node:.*)$",
                "message": "Registry code runs in consumers' browsers and Node/npm/pnpm projects."
              }
            ]
          }
        ],
        "p-otero/spacing-tokens": [
          "error",
          {
            "roles": [
              "gap-inline",
              "gap-items",
              "gap-group",
              "gap-section",
              "px-inset-chip",
              "py-inset-chip",
              "px-inset-item",
              "py-inset-item",
              "px-control-x",
              "p-inset-surface",
              "p-control-inset"
            ]
          }
        ],
        "eskais/no-inline-icons": "error",
        "eskais/scroll-area": "error"
      }
    },
    {
      "files": ["registry/ui/scroll-area.tsx"],
      "rules": {
        "eskais/scroll-area": "off"
      }
    },
    {
      "files": ["apps/**"],
      "rules": {
        "eskais/no-inline-icons": "error"
      }
    },
    {
      "files": ["apps/showcase/**"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"]
          }
        ]
      }
    },
    {
      "files": [
        "test/**",
        "tooling/screenshots.mjs",
        "tooling/contrast-check.mjs",
        "tooling/showcase-browser.mjs",
        "tooling/site-check.mjs",
        "tooling/list-bench.mjs",
        "tooling/diff-bench.mjs",
        "tooling/touch-check.mjs",
        "tooling/shell-check.mjs",
        "tooling/calendar-check.mjs",
        "tooling/press-check.mjs",
        "tooling/markdown-check.mjs",
        "tooling/document-workspace-check.mjs",
        "tooling/server-data-check.mjs",
        "tooling/find-check.mjs",
        "tooling/log-bench.mjs",
        "tooling/log-viewer-check.mjs",
        "tooling/perf/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["tooling/perf/**"],
      "rules": {
        "no-underscore-dangle": [
          "warn",
          {
            "allow": ["__REACT_DEVTOOLS_GLOBAL_HOOK__", "__perf", "__perfNav", "__perfWatch", "__vitals"]
          }
        ]
      }
    },
    {
      "files": ["test/**", "tooling/**", "apps/site/src/content/**", "registry/**/*-labels.ts", "packages/mockup/**"],
      "rules": {
        "max-lines": "off"
      }
    }
  ]
}
